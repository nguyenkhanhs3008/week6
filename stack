struct StackList {
    int arr[MAX];
    int topIndex;
    void init() {
        topIndex = -1;
    }
    bool isEmpty() { return topIndex == -1; }
    bool isFull() { return topIndex == MAX - 1; }
    int size() { return topIndex + 1; }
// Chèn đầu
    void ChenDau(int a) {
        if (isFull()) {
            cout << "Full"<<endl;
        }
        topIndex++;
        arr[topIndex] = a;
    }
// Xóa đầu
    int XoaDau() {
        if (isEmpty()) return -1;
        int v = arr[topIndex];
        topIndex--;
        return v;
    }
    int Top() {
        if (isEmpty()) return -1;
        return arr[topIndex];
    }
};
2. Dùng LinkedList
struct StackLinkedList {
    Node* head;
    int n;
    void init() {
        head = nullptr;
        n = 0;
    }
    bool isEmpty() { return head == nullptr; }
    int size() { return n; }
// Chèn đầu
    void ChenDau(int a) {
        Node* newNode = new Node();
        newNode->data = a;
        newNode->next = head;
        head = newNode;
        n++;
    }
// Xóa đầu
    int XoaDau() {
        if (isEmpty()) return -1;
        Node* temp = head;
        int v = temp->data;
        head = head->next;
        delete temp;
        n--;
        return v;
    }
    int top() {
        if (isEmpty()) return -1;
        return head->data;
    }
};
