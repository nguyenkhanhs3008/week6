2. Dùng LinkedList
struct Node {
    int data;
    Node* next;
};
struct QueueLinkedList {
    Node* head;
    Node* tail;
    int n;
    void init() {
        head = tail = nullptr;
    }
    bool isEmpty() { return head == nullptr; }
    //Chèn cuối
    void ChenCuoi(int a) {
        Node* newNode = new Node();
        newNode->data = a;
        newNode->next = nullptr;
        if (isEmpty()) {
            head = tail = newNode;
        } else {
            tail->next = newNode;
            tail = newNode;
        }
    }
//Xóa đầu
    int XoaDau() {
        if (isEmpty()) return -1;
        Node* temp = head;
        int v = temp->data;
        head = head->next;
        if (head == nullptr) tail = nullptr;
        delete temp;
        return v;
    }
